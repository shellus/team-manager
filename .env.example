# team-manager 环境变量示例。复制为 .env 并填写。.env 不入 git。

# 服务端口
PORT=

# 数据目录（母号 session 持久化在此，挂载卷）
TEAMMGR_DATA_DIR=

# JWT 签名密钥（务必改成强随机值）
TEAMMGR_JWT_SECRET=change-me-to-a-long-random-secret

# 管理员登录（二选一：明文 PASSWORD 首次启动自动 hash，或直接给 PASSWORD_HASH）
TEAMMGR_ADMIN_USER=admin
TEAMMGR_ADMIN_PASSWORD=change-me
# TEAMMGR_ADMIN_PASSWORD_HASH=$scrypt$N=16384,r=8,p=1$...$...

# CORS 白名单（逗号分隔；同源部署可留空）
# TEAMMGR_ALLOWED_ORIGINS=<allowed-origin-1>,<allowed-origin-2>

# 前端静态产物目录（生产由同进程 serveStatic 提供）
# TEAMMGR_WEB_DIST_DIR=./apps/web/dist

# Vite 开发服务器转发目标与允许访问主机
TEAMMGR_DEV_API_TARGET=
TEAMMGR_VITE_ALLOWED_HOSTS=

# ChatGPT 请求传输：Node 后端调用 curl_cffi sidecar，由 sidecar 走代理和浏览器 TLS 指纹
TEAMMGR_CURL_CFFI_URL=
TEAMMGR_CHATGPT_PROXY=
# TEAMMGR_CURL_CFFI_IMPERSONATE=chrome110
# TEAMMGR_CURL_CFFI_TIMEOUT=60

# Codex 自动授权：curl_cffi worker 内部调用 auth.openai.com、FlareSolverr 与 GongXi-Mail
# TEAMMGR_AUTH_PROXY=<http-or-socks-proxy-url>
# TEAMMGR_AUTH_IMPERSONATE=chrome146
# TEAMMGR_FLARESOLVERR_URL=<flaresolverr-url>
# TEAMMGR_GONGXI_MAIL_BASE_URL=<gongxi-mail-base-url>
# TEAMMGR_GONGXI_MAIL_API_KEY=<gongxi-mail-api-key>
# TEAMMGR_GONGXI_MAIL_TIMEOUT=150
# TEAMMGR_PHONE_POOL_YAML=<phone-pool-yaml-path>
# TEAMMGR_REGISTRATION_EMAIL_MAX_ATTEMPTS=3
# TEAMMGR_EMAIL_CODE_MAX_ATTEMPTS=3
# TEAMMGR_PHONE_CODE_MAX_ATTEMPTS=3
